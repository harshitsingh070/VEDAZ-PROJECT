# Port the HTTP + Socket.io server listens on
PORT=4000

# Comma-separated list of allowed frontend origins. "*" allows any origin.
# Example for local Expo web: http://localhost:8081
CORS_ORIGIN=*

# Storage type: 'file' (default, JSON on disk) or 'mysql' (Railway MySQL)
DB_TYPE=mysql

# --- MySQL (only needed when DB_TYPE=mysql) ---
# Railway provides MYSQL_URL, or use the individual variables below.
MYSQL_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=vedaz_chat

# Directory used by the JSON file store (when DB_TYPE=file)
DATA_DIR=data
